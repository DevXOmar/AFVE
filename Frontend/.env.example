# Frontend env vars (Vite)
# Copy to .env.local (or .env.development.local) and tweak if needed.

# Use real backend instead of mocks
VITE_AFVE_USE_API=true

# Base path used by the frontend when calling the backend.
# In development we recommend keeping this as /api and relying on Vite proxy.
VITE_AFVE_API_BASE=/api

# Optional: change where Vite proxies /api to.
# If unset, defaults to http://127.0.0.1:8000
# VITE_AFVE_API_TARGET=http://127.0.0.1:8000
